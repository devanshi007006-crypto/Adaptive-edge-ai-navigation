# HEADS-UP dataset — raw/large data is local-only
# Do not commit downloaded archives, extracted frame sequences, or caches.
# Keep metadata, adapters, documentation and validation results tracked.
validation/datasets/heads_up/*.tar
validation/datasets/heads_up/*.tar.gz
validation/datasets/heads_up/*.zip
validation/datasets/heads_up/raw/
validation/datasets/heads_up/cache/
validation/datasets/heads_up/sequences/
