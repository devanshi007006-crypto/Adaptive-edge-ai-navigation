# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class

# Virtual environments
venv/
.venv/
env/

# IDE / Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# Large model weights (track via download instructions, not direct repo commit)
models/detector/*.pt
models/detector/*.pth
models/detector/*.onnx
models/depth/*.pth
models/depth/*.pt
models/depth/*.onnx
*.pth
*.pt

