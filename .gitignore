adaptive_navigation/data/results/*.csv
adaptive_navigation/data/raw/*
!adaptive_navigation/data/raw/.gitkeep
adaptive_navigation/data/processed/*
!adaptive_navigation/data/processed/.gitkeep
adaptive_navigation/data/annotations/*
!adaptive_navigation/data/annotations/.gitkeep
